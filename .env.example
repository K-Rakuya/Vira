# ==============================================================================
# Vira - Environment Configuration Example
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Endpoint & Provider Configuration (OpenAI Compatible)
# Compatible with Ollama, llama.cpp, vLLM, LM Studio, Groq, or OpenAI
# ------------------------------------------------------------------------------
# Base URL for the OpenAI-compatible chat completions endpoint.
# Local Ollama:     http://localhost:11434/v1
# Local llama.cpp:  http://127.0.0.1:8080/v1
# Local vLLM:       http://localhost:8000/v1
# Official OpenAI:  https://api.openai.com/v1
OPENAI_API_BASE=http://localhost:11434/v1

# API Key for authentication (use 'dummy' or leave empty for local offline models like Ollama/llama.cpp)
OPENAI_API_KEY=dummy

# Default LLM model identifier
# Examples: qwen2.5:7b, llama3.2:3b, gpt-4o-mini, deepseek-r1:8b
OPENAI_MODEL=qwen2.5:7b

# LLM sampling temperature (0.0 = deterministic, 0.7 = creative conversation)
VIRA_LLM_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# Offline Voice Pipeline Models Directory
# ------------------------------------------------------------------------------
# Path to local directory containing downloaded Sherpa-ONNX, Piper, Kokoro,
# and Silero VAD models. Defaults to `./models` within the repository root if unset.
# Run `./scripts/download_offline_voice_models.sh` to download these assets.
VIRA_MODELS_DIR=./models

# Preferred TTS voice engine: "piper" (Vietnamese/English) or "kokoro" (Multilingual)
VIRA_TTS_ENGINE=piper

# Default speech synthesis rate (0.5 to 2.0; 1.0 = normal)
VIRA_TTS_SPEED=1.0

# ------------------------------------------------------------------------------
# Storage & Database
# ------------------------------------------------------------------------------
# Path to local SQLite database file for conversation history, flashcards, and profiles.
# If unset, defaults to `./vira.db` or standard OS application data directory.
VIRA_DATABASE_PATH=./vira.db

# ------------------------------------------------------------------------------
# Logging & Debugging
# ------------------------------------------------------------------------------
# Rust logging level filter (trace, debug, info, warn, error)
RUST_LOG=info,vira=debug,tower_http=debug
RUST_BACKTRACE=1
